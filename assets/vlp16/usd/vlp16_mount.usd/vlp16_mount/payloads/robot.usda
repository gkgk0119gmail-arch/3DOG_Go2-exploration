#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.1.3"
    }
    defaultPrim = "vlp16_mount"
    doc = """Generated from Composed Stage of root layer /tmp/tmpthlk6pkw/vlp16_mount.usdc


Generated from Composed Stage of root layer /tmp/urdf_import_vlp16_mount_zamea_8l/usdex_vlp16_mount/vlp16_mount.usdc


Generated from Composed Stage of root layer /tmp/urdf_import_vlp16_mount_zamea_8l/temp_vlp16_mount/vlp16_mount.usd


Generated from Composed Stage of root layer /home/dlab27/Desktop/3DOG/sim/assets/vlp16/usd/vlp16_mount.usd/vlp16_mount/payloads/base.usd
"""
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "vlp16_mount" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    custom rel isaac:physics:robotJoints
    custom rel isaac:physics:robotLinks

    over "Geometry"
    {
        over "vlp16_mount" (
            prepend apiSchemas = ["IsaacLinkAPI"]
        )
        {
        }
    }

    over "Physics"
    {
        over "root_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }
    }
}

