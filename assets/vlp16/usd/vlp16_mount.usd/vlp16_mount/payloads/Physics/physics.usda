#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.1.3"
    }
    defaultPrim = "vlp16_mount"
    doc = """Generated from Composed Stage of root layer /tmp/tmpthlk6pkw/vlp16_mount.usdc


Generated from Composed Stage of root layer /tmp/urdf_import_vlp16_mount_zamea_8l/usdex_vlp16_mount/vlp16_mount.usdc


Generated from Composed Stage of root layer /tmp/urdf_import_vlp16_mount_zamea_8l/temp_vlp16_mount/vlp16_mount.usd


Generated from Composed Stage of root layer /home/dlab27/Desktop/3DOG/sim/assets/vlp16/usd/vlp16_mount.usd/vlp16_mount/payloads/base.usd
"""
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "vlp16_mount"
{
    over "Geometry" (
        prepend apiSchemas = ["PhysicsArticulationRootAPI", "NewtonArticulationRootAPI"]
    )
    {
        bool newton:selfCollisionEnabled = 0

        over "vlp16_mount" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
        )
        {
            point3f physics:centerOfMass = (0, 0, 0.03585)
            float3 physics:diagonalInertia = (0.0009080594, 0.0009080594, 0.0011049624)
            float physics:mass = 0.83
            quatf physics:principalAxes = (1, 0, 0, 0)
        }
    }

    over "Physics"
    {
        def PhysicsFixedJoint "root_joint"
        {
            custom rel physics:body0
            prepend rel physics:body0 = </vlp16_mount>
            custom rel physics:body1
            prepend rel physics:body1 = </vlp16_mount/Geometry/vlp16_mount>
            point3f physics:localPos0 = (0, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }
    }
}

