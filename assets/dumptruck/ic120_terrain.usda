    def "Looks"
    {
        def Material "M0"
        {
            token outputs:surface.connect = </World/Looks/M0/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </World/Looks/M0/Tex.outputs:rgb>
                float inputs:roughness = 0.7
                token outputs:surface
            }

            def Shader "st"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "Tex"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @textures/white.png@
                float2 inputs:st.connect = </World/Looks/M0/st.outputs:result>
                float3 outputs:rgb
            }
        }

        def Material "M1"
        {
            token outputs:surface.connect = </World/Looks/M1/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </World/Looks/M1/Tex.outputs:rgb>
                float inputs:roughness = 0.7
                token outputs:surface
            }

            def Shader "st"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "Tex"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @textures/ic120.png@
                float2 inputs:st.connect = </World/Looks/M1/st.outputs:result>
                float3 outputs:rgb
            }
        }
    }
}

